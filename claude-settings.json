{
  "permissions": {
    "allow": [
      "Bash(laws exec *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git stash list*)",
      "Bash(git fetch)",
      "Bash(git fetch --all)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(tr *)",
      "Bash(terraform plan*)",
      "Bash(terraform show*)",
      "Bash(terraform validate*)",
      "Bash(terraform output*)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)",
      "Bash(go build*)",
      "Bash(go vet*)",
      "Bash(go test*)",
      "Bash(gofumpt *)",
      "Bash(golangci-lint *)",
      "Bash(pwd)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(rm -rf .claude/tmp/*)",
      "Bash(rm -r .claude/tmp/*)",
      "Bash(rm .claude/tmp/*)",
      "Bash(rmdir .claude/tmp/*)"
    ],
    "additionalDirectories": [
      "/home/m-yoshimo/work/genda/repositories/u1-api/.claude/tasks",
      "/home/m-yoshimo/work/genda/repositories/u1-web/.claude/tasks",
      "/home/m-yoshimo/.claude/memory"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "now=$(TZ='Asia/Tokyo' date '+%Y-%m-%d %H:%M:%S %Z'); printf '【現在時刻 JST: %s】回答の冒頭に必ずこの時刻を表示すること。' \"$now\" | jq -Rs '{hookSpecificOutput:{hookEventName:\"UserPromptSubmit\",additionalContext:.}}'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '⚠️最優先事項（Tier 0 を毎回照合。作業全体の承認を得るまで着手しない）:\\n%s' \"$(cat \"$HOME/.claude/memory/MEMORY.md\" 2>/dev/null)\" | jq -Rs '{hookSpecificOutput:{hookEventName:\"UserPromptSubmit\",additionalContext:.}}'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/rm_grant.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/rule_guard.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/delegate_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/taskdef_review_prompt.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/memory_lint.py\" --hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '⚠️セッション開始：メモリ本体（索引）。作業全体の承認を得るまで着手しない。\\n%s' \"$(cat \"$HOME/.claude/memory/MEMORY.md\" 2>/dev/null)\" | jq -Rs '{hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:.}}'"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 1 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 2 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 3 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 4 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 5 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 6 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 7 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 8 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 9 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 10 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 11 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 12 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 13 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 14 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 15 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 16 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_rules.py\" 17 17"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/taskdef_status.py\" --session-start"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/delegate_guard.py\" --sweep"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/taskdef_status.py\" --stop"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/delegate_guard.py\" --stop"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls@claude-code-lsps": true,
    "vtsls@claude-code-lsps": true,
    "gopls-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-code-lsps": {
      "source": {
        "source": "git",
        "url": "https://github.com/boostvolt/claude-code-lsps.git"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  }
}
